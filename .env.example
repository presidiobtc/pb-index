# Required for grounded answer synthesis and zero-result query rewriting.
OPENAI_API_KEY=

# Recommended quality/cost balance for the final archive answer.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium

# Used only when deterministic retrieval returns no evidence. This bounded pass
# translates or closely reformulates the query; it never answers the question.
ASK_QUERY_MODEL=gpt-5.6-luna
ASK_QUERY_REASONING_EFFORT=low
ASK_QUERY_REWRITE_ENABLED=true

# Optional operational limits. These values are also the built-in defaults.
ASK_DEFAULT_SOURCE_LIMIT=10
ASK_MAX_SOURCE_LIMIT=20
ASK_MAX_QUERY_LENGTH=2000
ASK_OPENAI_TIMEOUT_MS=30000
ASK_QUERY_REWRITE_TIMEOUT_MS=12000
ASK_RATE_LIMIT_PER_MINUTE=30

# Set this to your deployment's origin (for example, https://archive.example.com)
# when hosting a fork. Production shared-answer links otherwise use pbarchive.ai.
ASK_PUBLIC_ORIGIN=

# Set true to stop saving new generated answers as public, shareable snapshots
# in Netlify Blobs. Existing snapshots remain readable; this does not delete them.
# Leave blank for the built-in behavior: snapshots are enabled on Netlify.
ASK_SNAPSHOTS_DISABLED=

# Optional comma-separated browser Origin allowlist for the public MCP endpoint.
# Native/server MCP clients normally omit Origin. PB's production domains and
# localhost are allowed automatically.
MCP_ALLOWED_ORIGINS=

# Optional model-assisted editorial pass for Featured Now. It reuses
# OPENAI_API_KEY; when the key is absent, selection degrades to the deterministic
# ranker instead of failing the build.
FEATURED_JUDGE_ENABLED=true
FEATURED_JUDGE_MODEL=gpt-5.6-sol
FEATURED_JUDGE_REASONING_EFFORT=low
FEATURED_JUDGE_TIMEOUT_MS=30000

# Optional override for last-known-good reads. Netlify's built-in URL variable is
# used automatically in production, so this is normally left blank.
FEATURED_PREVIOUS_URL=

# Required by the scheduled refresh function. Create a Netlify build hook for
# the production branch and store its full, secret URL in this variable.
NETLIFY_BUILD_HOOK_URL=
